---
import MainLayout from "../layouts/MainLayout.astro";
import "../service.scss";
import ServiceCard from "../components/ServiceCard.astro";
import { strength_training } from "../services";
---

<MainLayout>
  <section class="service_banner strength_banner pad">
    <div class="section_content col">
      <div class="col">
        <h1 data-aos="fade-right">
          <span class="latte">RE-HUB</span>
          <br />
          <span class="orange">STRENGTH TRAINING</span>
        </h1>
        <br />
        <p>
          "Our strength training programs are designed to build power, improve
          mobility, and enhance overall physical performance—whether you're
          recovering from injury, boosting athletic ability, or working toward
          personal fitness goals."
        </p>
      </div>
    </div>
  </section>
  <section class="services">
    <div class="section_content pad col">
      <div class="breadcrumb">
        Our Services >
        <span class="orange">Strength Training</span>
      </div>
      <div class="service_listing">
        {strength_training.map((item) => <ServiceCard info={item} />)}
      </div>
    </div>
  </section>
</MainLayout>
