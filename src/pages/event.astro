---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Event">
    <div
        id="event-loading"
        class="section_content colc"
        style="height:60vh; justify-content:center"
    >
        <div class="loader"></div>
    </div>

    <section id="event-content" style="display: none; padding-block: 2rem; ">
        <!-- Hero Image Section -->
        <div class="section_content">
            <img
                id="event-img"
                src=""
                alt="Event Image"
                style="width: 100%; height: 100%; object-fit: cover; margin-bottom:5rem"
            />
        </div>

        <!-- Form Section -->
        <div class="section_content colc event_form_section pad">
            <div class="section_title colc">
                <h5 data-aos="flip-up">Register for this event</h5>
                <h1 data-aos="fade-right">
                    <span class="latte">JOIN US</span>
                    <span class="orange">NOW</span>
                </h1>
            </div>
            <div id="form-container" class="colc" style="width: 100%;">
                <form id="dynamic-event-form" class="form col">
                    <!-- Fields will be injected here -->
                    <button
                        type="submit"
                        class="cta_btn"
                        style="margin-top: 2rem;">Register Now</button
                    >
                </form>

                <div
                    id="submit-success"
                    class="contact_status row"
                    style="display: none; margin-top: 2rem;"
                >
                    <span class="material-symbols-outlined">
                        check_circle
                    </span>
                    <strong>Registration successful! See you there.</strong>
                </div>
            </div>
        </div>
    </section>

    <section id="inactive_content" style="display: none; padding-block: 2rem; ">
        <div class="section_content colc">
            <h2 class="orange">This event is currently inactive.</h2>
            <p class="latte">Please check back later for updates!</p>
        </div>
    </section>
</MainLayout>

<script>
    // 1. Improved Type Safety & Utility
    const fileToBase64 = (file: File): Promise<string> => {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.readAsDataURL(file);
            reader.onload = () => resolve(reader.result as string);
            reader.onerror = (error) => reject(error);
        });
    };

    // Helper to create form elements dynamically
    function createFieldElement(field: any) {
        const fieldId = field.label.toLowerCase().replace(/\s+/g, "_");
        let input: HTMLInputElement | HTMLTextAreaElement;

        if (field.type === "textarea") {
            input = document.createElement("textarea");
            input.rows = 4;
        } else {
            input = document.createElement("input");
            input.type = field.type;
        }

        input.id = fieldId;
        input.name = fieldId;
        input.placeholder = field.placeholder;
        input.value = field.prefill || "";
        input.required = true;
        input.className = "form-input-style"; // Use your existing CSS class

        return { input, fieldId };
    }

    function renderEventData(data: any) {
        const elements = {
            loading: document.getElementById("event-loading"),
            content: document.getElementById("event-content"),
            eventImg: document.getElementById("event-img") as HTMLImageElement,
            eventName: document.getElementById("event-name"),
            form: document.getElementById(
                "dynamic-event-form",
            ) as HTMLFormElement,
            inactiveContent: document.getElementById("inactive_content"),
            successMsg: document.getElementById("submit-success"),
        };

        if (elements.loading) elements.loading.style.display = "none";

        if (!data || !data.active) {
            if (elements.inactiveContent)
                elements.inactiveContent.style.display = "flex";
            if (elements.content) elements.content.style.display = "none";
            return;
        }

        if (elements.content) elements.content.style.display = "block";
        if (elements.eventImg) elements.eventImg.src = data.event_img;
        if (elements.eventName) elements.eventName.innerText = data.event_name;

        // Prevent double rendering in Astro/Client-side navigation
        if (elements.form && !elements.form.dataset.rendered) {
            const submitBtn = elements.form.querySelector(
                'button[type="submit"]',
            );

            data.form.forEach((field: any) => {
                const { input, fieldId } = createFieldElement(field);

                // Wrapper for consistent spacing
                const wrapper = document.createElement("div");
                wrapper.className = "field-wrapper col";
                wrapper.style.marginBottom = "1rem";
                wrapper.style.width = "100%";

                const label = document.createElement("label");
                label.htmlFor = fieldId;
                label.innerText = field.label;
                label.className = "latte"; // Matching your minimalist style
                label.style.fontSize = "0.9rem";

                wrapper.appendChild(label);
                wrapper.appendChild(input);

                if (submitBtn) {
                    elements.form.insertBefore(wrapper, submitBtn);
                }
            });

            elements.form.dataset.rendered = "true";

            // 2. Refined Submission Logic
            elements.form.addEventListener("submit", async (e) => {
                e.preventDefault();
                const submitBtnEl = submitBtn as HTMLButtonElement;
                const originalText = submitBtnEl.innerText;

                submitBtnEl.innerText = "Processing...";
                submitBtnEl.disabled = true;

                try {
                    const formData = new FormData(elements.form);
                    const payload: Record<string, any> = {};

                    // Map fields to payload
                    for (const [key, value] of formData.entries()) {
                        if (value instanceof File && value.size > 0) {
                            const base64String = await fileToBase64(value);
                            payload[key] = {
                                name: value.name,
                                type: value.type,
                                data: base64String.split(",")[1], // Send only the clean data
                            };
                        } else if (!(value instanceof File)) {
                            payload[key] = value;
                        }
                    }

                    const response = await fetch(
                        import.meta.env.PUBLIC_GET_EVENT_APPSCRIPT,
                        {
                            method: "POST",
                            body: JSON.stringify(payload),
                            mode: "no-cors", // Use 'no-cors' if you face redirect issues, though JSON response won't be readable
                        },
                    );

                    elements.form.style.display = "none";
                    if (elements.successMsg)
                        elements.successMsg.style.display = "flex";
                } catch (err) {
                    console.error("Submission Error:", err);
                    alert("There was an error. Please try again.");
                } finally {
                    submitBtnEl.innerText = originalText;
                    submitBtnEl.disabled = false;
                }
            });
        }
    }

    window.addEventListener("event-data-ready", (e: any) => {
        renderEventData(e.detail);
    });
</script>
