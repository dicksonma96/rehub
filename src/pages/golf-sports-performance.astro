---
import MainLayout from "../layouts/MainLayout.astro";
import "../service.scss";
import ServiceCard from "../components/ServiceCard.astro";
import { sports_golf } from "../services";
import { whatsapp_href } from "../site_config";
---

<MainLayout title="Sports & Golf Performance">
  <section class="service_banner sports_golf_banner pad">
    <div class="section_content col">
      <div class="col">
        <h1 data-aos="fade-right">
          <span class="latte">RE-HUB</span>
          <br />
          <span class="orange">SPORTS & GOLF PERFORMANCE</span>
        </h1>
        <br />
        <p>
          "Our sports and golf performance programs are designed to help
          athletes and active individuals move efficiently, build sport-specific
          strength, and perform better — while reducing injury risk."
        </p>
        <div class="tag">THIS IS FOR YOU IF YOU</div>
        <div class="row for_you">
          <div class="for_you_item row">
            <img
              src="/assets/img/golf_foryou1.png"
              alt="Play sport or golf regularly"
            />
            <p>Play sport or golf <br /> regularly</p>
          </div>
          <div class="for_you_item row">
            <img
              src="/assets/img/golf_foryou2.png"
              alt="Want to improve performance or efficiency"
            />
            <p>Want to improve performance <br /> or efficiency</p>
          </div>
          <div class="for_you_item row">
            <img
              src="/assets/img/golf_foryou3.png"
              alt="Want structured training beyond technique
"
            />
            <p>Want structured training <br /> beyond technique</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="services">
    <div class="section_content pad col">
      <div class="breadcrumb">
        Our Services >
        <span class="orange">Sports & Golf Performance</span>
      </div>
      <div class="service_listing">
        {sports_golf.map((item) => <ServiceCard info={item} />)}
      </div>
    </div>
  </section>

  <div class="section_content contact_footer colc">
    <h1 data-aos="fade-right">NOT SURE WHERE TO START?</h1>
    <h2 class="orange">
      Book an assessment and let our team guide you to the right approach
    </h2>
    <a href={whatsapp_href()} class="cta_btn" target="_blank">Book A Session</a>
  </div>
</MainLayout>
