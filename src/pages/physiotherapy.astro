---
import MainLayout from "../layouts/MainLayout.astro";
import "../service.scss";
import ServiceCard from "../components/ServiceCard.astro";
import { physiotherapy } from "../services";
import { whatsapp_href } from "../site_config.js";
---

<MainLayout title="Physiotherapy">
  <section class="service_banner physio_banner pad">
    <div class="section_content col">
      <div class="col">
        <h1 data-aos="fade-right">
          <span class="latte">RE-HUB</span>
          <br />
          <span class="orange">PHYSIOTHERAPY</span>
        </h1>
        <br />
        <p>
          Our physiotherapy services combine hands-on treatments, advanced
          modalities, and personalized care plans to relieve pain, restore
          mobility, and support recovery—whether you're healing from injury,
          managing chronic conditions, or improving overall physical function.
        </p>
        <div class="tag">THIS IS FOR YOU IF YOU</div>
        <div class="row for_you">
          <div class="for_you_item row">
            <img
              src="/assets/img/physio_foryou1.png"
              alt="Have persistent or recurring  pain"
            />
            <p>Have persistent or <br /> recurring pain</p>
          </div>
          <div class="for_you_item row">
            <img
              src="/assets/img/physio_foryou2.png"
              alt="Are recovering from an injury"
            />
            <p>Are recovering from <br /> injury or surgery</p>
          </div>
          <div class="for_you_item row">
            <img
              src="/assets/img/physio_foryou3.png"
              alt="Feel limited in movement"
            />
            <p>Feel limited in <br /> movement</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="services">
    <div class="section_content pad col">
      <div class="breadcrumb">
        Our Services >
        <span class="orange">Physiotherapy</span>
      </div>
      <div class="service_listing">
        {physiotherapy.map((item) => <ServiceCard info={item} />)}
      </div>
    </div>
  </section>

  <div class="section_content contact_footer colc">
    <h1 data-aos="fade-right">NOT SURE WHERE TO START?</h1>
    <h2 class="orange">
      Book an assessment and let our team guide you to the right approach
    </h2>
    <a href={whatsapp_href()} class="cta_btn" target="_blank">Book A Session</a>
  </div>
</MainLayout>
