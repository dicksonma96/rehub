</dialog>

<script></script>

<script>
  const close_btn = document.querySelectorAll(".close_modal");
  const open_btn = document.querySelectorAll(".team_card .cta_btn");
  const dialogs = document.querySelectorAll("dialog");

  open_btn.forEach((button) => {
    button.addEventListener("click", () => {
      // Get data from the button's attributes
      const { modal } = (button as HTMLElement).dataset;
      const dialog = document.querySelector("." + modal);
      dialog.showModal();
    });
  });

  dialogs.forEach((dialog) => {
    dialog.addEventListener("click", () => dialog.close());

    dialog
      .querySelector(".modal_content")
      ?.addEventListener("click", (e) => e.stopPropagation());
  });

  close_btn.forEach((button) => {
    button.addEventListener("click", () => {
      dialogs.forEach((d) => d.close());
    });
  });
</script>
