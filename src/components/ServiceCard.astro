---
import { whatsapp_href } from "../site_config";
const { name, description, img } = Astro.props.info;
---

<div class="service_card col">
  <img src={`./assets/img/services/${img}.jpg`} alt={name} />

  <div class="info col">
    <strong>{name}</strong>
    <p>{description}</p>
    <br />
    <a
      href={whatsapp_href(`Hi, I would like to enquire about ${name}`)}
      class="cta_btn">Book Now</a
    >
  </div>
</div>
