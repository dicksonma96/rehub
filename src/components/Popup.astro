---
---

<dialog id="popup-modal" class="popup_modal">
  <div class="popup_content">
    <button id="close-popup" class="close_btn">&times;</button>
    <a id="popup-link" href="#" target="_blank">
      <img id="popup-img" src="" alt="Event Popup" />
    </a>
  </div>
</dialog>

<script>
  const modal = document.getElementById('popup-modal') as HTMLDialogElement;
  const closeBtn = document.getElementById('close-popup');
  const popupImg = document.getElementById('popup-img') as HTMLImageElement;
  const popupLink = document.getElementById('popup-link') as HTMLAnchorElement;

  if (modal && closeBtn) {
    const setModalCloseCookie = () => {
      const d = new Date();
      d.setTime(d.getTime() + (24 * 60 * 60 * 1000));
      document.cookie = "modalClose=true;expires=" + d.toUTCString() + ";path=/";
    };

    closeBtn.addEventListener('click', () => {
      modal.close();
      setModalCloseCookie();
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.close();
        setModalCloseCookie();
      }
    });

    // Listen for global event to show popup
    window.addEventListener('show-popup', (e: any) => {
      const { img_url, redirect_url } = e.detail;
      if (popupImg && img_url) {
        popupImg.src = img_url;
        if (popupLink) {
          popupLink.href = redirect_url || '#';
        }
        modal.showModal();
      }
    });
  }
</script>
